<div class="page-heading"><div><span class="eyebrow">MEMBERS</span><h1>Người dùng</h1><p>Quản lý quyền, trạng thái tài khoản và thành viên VIP.</p></div></div>
<form class="filters" method="get"><label>Tìm tài khoản<input name="q" value="<%= q %>" maxlength="100" placeholder="Tên hoặc email..."></label><label>Quyền<select name="role"><% [['','Tất cả'],['user','Thành viên'],['admin','Admin']].forEach(([value,label]) => { %><option value="<%= value %>" <%= role === value ? 'selected' : '' %>><%= label %></option><% }); %></select></label><label>Trạng thái<select name="state"><% [['','Tất cả'],['active','Hoạt động'],['blocked','Đã khóa'],['vip','VIP']].forEach(([value,label]) => { %><option value="<%= value %>" <%= state === value ? 'selected' : '' %>><%= label %></option><% }); %></select></label><button class="button primary">Lọc</button><a class="button subtle" href="/admin/users">Đặt lại</a></form>
<div class="notice">Tài khoản admin được bảo vệ khỏi đổi quyền hoặc khóa qua web. Mọi thay đổi tài khoản thành viên sẽ yêu cầu người đó đăng nhập lại.</div>
<section class="panel table-wrap"><table><caption class="sr-only">Danh sách người dùng</caption><thead><tr><th>Tài khoản</th><th>Ngày đăng ký</th><th>Quyền</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead><tbody>
<% items.forEach(member => { %><tr><td><strong><%= member.username %></strong><small><%= member.email %></small></td><td><%= new Date(member.createdAt).toLocaleDateString('vi-VN') %></td><td><span class="badge <%= member.role === 'admin' ? 'blue' : '' %>"><%= member.role %></span></td><td><span class="badge <%= member.isBlocked ? 'red' : 'green' %>"><%= member.isBlocked ? 'Đã khóa' : 'Hoạt động' %></span> <% if (member.isVip) { %><span class="badge gold" title="<%= member.vipPlan || 'VIP' %>">VIP <%= member.vipPlan ? '(' + member.vipPlan + ')' : '' %></span><% if (member.vipExpiresAt) { %><small style="display:block;color:#f59e0b;font-size:0.75rem;margin-top:2px;">Hạn: <%= new Date(member.vipExpiresAt).toLocaleDateString('vi-VN') %></small><% } else { %><small style="display:block;color:#10b981;font-size:0.75rem;margin-top:2px;">Vô thời hạn</small><% } %><% } %></td><td>
<% if (member.role === 'admin') { %><span class="muted">Tài khoản được bảo vệ</span><% } else { %>
<details class="row-editor"><summary>Chỉnh sửa</summary><form method="post" action="/admin/users/<%= member._id %>" data-confirm="Lưu thay đổi tài khoản? Người dùng sẽ phải đăng nhập lại."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= member.__v || 0 %>"><label>Quyền<select name="role"><option value="user" <%= member.role === 'user' ? 'selected' : '' %>>Thành viên</option><option value="admin" <%= member.role === 'admin' ? 'selected' : '' %>>Admin</option></select></label><label>Cấp VIP theo gói<select name="vipPlanAction"><option value="keep">-- Giữ nguyên (<%= member.isVip ? (member.vipPlan || 'Đang có VIP') : 'Không VIP' %>) --</option><option value="remove">Hủy gói VIP (Về tài khoản thường)</option><% if (typeof vipPlans !== 'undefined' && vipPlans.length > 0) { %><optgroup label="Cấp theo gói cước"><% vipPlans.forEach(plan => { %><option value="<%= plan.code %>"><%= plan.name %> (<%= plan.durationDays %> ngày - <%= Number(plan.price).toLocaleString('vi-VN') %>đ)</option><% }); %></optgroup><% } %><option value="lifetime">VIP Vô thời hạn (Vĩnh viễn)</option></select></label><label>Trạng thái<select name="isBlocked"><option value="false" <%= !member.isBlocked ? 'selected' : '' %>>Hoạt động</option><option value="true" <%= member.isBlocked ? 'selected' : '' %>>Khóa</option></select></label><button class="button primary">Lưu thay đổi</button></form></details>
<% } %></td></tr><% }); %>
<% if (!items.length) { %><tr><td colspan="5" class="empty">Không tìm thấy tài khoản phù hợp.</td></tr><% } %>
</tbody></table></section>
<%- include('pagination') %>
