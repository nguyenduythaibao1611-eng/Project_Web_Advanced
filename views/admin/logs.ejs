<div class="page-heading"><div><span class="eyebrow">AUDIT TRAIL</span><h1>Nhật ký hoạt động</h1><p>Theo dõi thao tác quản trị và kết quả xử lý.</p></div></div>
<form class="filters" method="get"><label>Tìm nhật ký<input name="q" value="<%= q %>" maxlength="100" placeholder="Admin, hành động hoặc đối tượng..."></label><button class="button primary">Tìm kiếm</button><a href="/admin/logs" class="button subtle">Đặt lại</a></form>
<div class="notice">“Chưa xác nhận” nghĩa là tác vụ chưa hoàn tất hoặc bị gián đoạn. Với tác vụ lỗi, hãy kiểm tra dữ liệu hiện tại trước khi thử lại.</div>
<section class="panel table-wrap"><table><caption class="sr-only">Nhật ký quản trị</caption><thead><tr><th>Thời gian</th><th>Admin</th><th>Thao tác</th><th>Nội dung</th><th>Kết quả</th></tr></thead><tbody><% items.forEach(log => { %><tr><td><%= new Date(log.createdAt).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' }) %></td><td><%= log.actorName %></td><td><strong><%= log.action %></strong><small><%= log.target %></small></td><td><%= log.summary %></td><td><span class="badge <%= log.status === 'success' ? 'green' : log.status === 'failed' ? 'red' : '' %>"><%= ({pending:'Chưa xác nhận',success:'Thành công',failed:'Lỗi'})[log.status] %></span></td></tr><% }); %><% if (!items.length) { %><tr><td colspan="5" class="empty">Chưa có nhật ký phù hợp.</td></tr><% } %></tbody></table></section><%- include('pagination') %>
