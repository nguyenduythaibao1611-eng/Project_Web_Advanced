<% const editing = Boolean(movie._id);
const value = key => typeof movie[key] === 'string' || typeof movie[key] === 'number' ? movie[key] : '';
const joined = key => Array.isArray(movie[key]) ? movie[key].map(item => typeof item === 'string' ? item : item.name).join(', ') : value(key);
const episodes = typeof submittedEpisodes !== 'undefined' ? submittedEpisodes : (movie.danh_sach_server || []).flatMap(server => server.server_data.map(episode => ({server:server.server_name,type:server.server_type,name:episode.name,slug:episode.slug,embed:episode.link_embed,hls:episode.link_m3u8})));
%>
<div class="page-heading"><div><span class="eyebrow">MOVIE EDITOR</span><h1><%= editing ? 'Chỉnh sửa phim' : 'Thêm phim mới' %></h1><p>Điền thông tin, thêm nguồn phát và chọn trạng thái xuất bản.</p></div><a class="button subtle" href="/admin/movies">← Danh sách phim</a></div>
<% if (error) { %><div class="notice danger" role="alert"><%= error %></div><% } %>
<form method="post" action="<%= editing ? '/admin/movies/' + movie._id : '/admin/movies' %>" id="movie-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= movie.__v || 0 %>">
    <section class="panel form-panel"><h2>Thông tin phim</h2><div class="form-grid">
        <label>Tên phim *<input name="title" required maxlength="200" value="<%= value('title') %>"></label>
        <label>Slug *<input name="slug" required maxlength="180" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="<%= value('slug') %>" placeholder="vi-du-ten-phim"><small>Chữ thường không dấu, số và dấu gạch nối.</small></label>
        <label>Tên gốc<input name="origin_name" maxlength="200" value="<%= value('origin_name') %>"></label>
        <label>Năm phát hành<input type="number" name="year" min="1888" max="2100" value="<%= value('year') %>"></label>
        <label>Loại phim<select name="type"><% [['single','Phim lẻ'],['series','Phim bộ'],['hoathinh','Hoạt hình'],['tvshows','TV Show']].forEach(([val,label]) => { %><option value="<%= val %>" <%= value('type') === val ? 'selected' : '' %>><%= label %></option><% }); %></select></label>
        <label>Tiến độ<select name="status"><% [['completed','Hoàn thành'],['ongoing','Đang cập nhật'],['trailer','Trailer']].forEach(([val,label]) => { %><option value="<%= val %>" <%= value('status') === val ? 'selected' : '' %>><%= label %></option><% }); %></select></label>
        <label class="full">Nội dung<textarea name="overview" rows="5" maxlength="10000"><%= value('overview') %></textarea></label>
        <% [['genres','Thể loại'],['countries','Quốc gia'],['actor','Diễn viên'],['director','Đạo diễn']].forEach(([key,label]) => { %><label><%= label %><input name="<%= key %>" value="<%= joined(key) %>" maxlength="2000"><small>Ngăn cách nhiều mục bằng dấu phẩy.</small></label><% }); %>
        <% [['time','Thời lượng','120 phút'],['quality','Chất lượng','HD'],['lang','Ngôn ngữ','Vietsub'],['episode_current','Tập hiện tại','Full'],['episode_total','Tổng số tập','1']].forEach(([key,label,placeholder]) => { %><label><%= label %><input name="<%= key %>" value="<%= value(key) %>" maxlength="<%= key === 'quality' || key === 'episode_total' ? 20 : 60 %>" placeholder="<%= placeholder %>"></label><% }); %>
    </div></section>
    <section class="panel form-panel"><h2>Hình ảnh & trailer</h2><p class="muted">Dán URL ảnh hoặc tải ảnh PNG, JPEG, WebP tối đa 5 MB. Ảnh tải lên được lưu trên máy chủ website.</p><div class="form-grid">
        <% [['poster_url','Poster'],['backdrop_url','Ảnh nền']].forEach(([key,label]) => { %><div class="image-field"><label><%= label %><input name="<%= key %>" id="<%= key %>" value="<%= value(key) %>" maxlength="2000" placeholder="https://..."></label><label class="upload-label">Tải ảnh lên<input type="file" accept="image/png,image/jpeg,image/webp" data-upload="<%= key %>"></label><p class="upload-status" role="status"></p></div><% }); %>
        <label class="full">URL trailer<input name="trailer_url" maxlength="2000" value="<%= value('trailer_url') %>" placeholder="https://..."></label>
    </div></section>
    <section class="panel form-panel"><div class="panel-heading"><div><h2>Tập & nguồn phát</h2><p class="muted">Các tập cùng tên và loại server được gom thành một server khi lưu.</p></div><button class="button subtle" type="button" id="add-episode">＋ Thêm tập</button></div>
        <div id="episodes"><% episodes.forEach((episode,index) => { %><fieldset class="episode"><legend>Tập phim</legend><div class="form-grid">
            <% [['server','Tên server'],['name','Tên tập'],['slug','Slug tập'],['embed','URL nhúng (iframe)'],['hls','URL HLS (.m3u8)']].forEach(([key,label]) => { %><label><%= label %><input name="episodes[<%= index %>][<%= key %>]" data-key="<%= key %>" value="<%= typeof episode[key] === 'string' ? episode[key] : '' %>" maxlength="<%= key === 'embed' || key === 'hls' ? 2000 : key === 'slug' ? 180 : 100 %>" <%= ['server','name','slug'].includes(key) ? 'required' : '' %>></label><% }); %>
            <label>Loại nguồn<select name="episodes[<%= index %>][type]" data-key="type"><option value="iframe" <%= episode.type === 'iframe' ? 'selected' : '' %>>Iframe</option><option value="m3u8" <%= episode.type === 'm3u8' ? 'selected' : '' %>>HLS</option></select></label>
        </div><button type="button" class="button danger-button remove-episode">Bỏ tập này</button></fieldset><% }); %></div>
        <p id="episode-status" class="muted" role="status">Tối đa 100 tập mỗi lần lưu. Phim chưa có nguồn phát vẫn có thể lưu nháp.</p>
    </section>
    <section class="panel form-panel"><h2>Xuất bản</h2><div class="form-grid"><label>Trạng thái<select name="isPublished"><option value="false" <%= movie.isPublished === false ? 'selected' : '' %>>Ẩn / bản nháp</option><option value="true" <%= movie.isPublished !== false ? 'selected' : '' %>>Hiển thị công khai</option></select></label><label>Quyền xem<select name="isVip"><option value="false" <%= !movie.isVip ? 'selected' : '' %>>Miễn phí</option><option value="true" <%= movie.isVip ? 'selected' : '' %>>Chỉ thành viên VIP và admin</option></select></label></div><p class="muted">Ẩn phim sẽ gỡ phim khỏi thư viện và chặn đường dẫn công khai; dữ liệu vẫn được giữ lại.</p></section>
    <div class="form-actions"><a href="/admin/movies" class="button subtle">Hủy</a><button type="submit" class="button primary">Lưu phim</button><% if (editing && movie.isPublished !== false) { %><a class="button subtle" href="/library/<%= value('slug') %>" target="_blank" rel="noopener">Xem trang công khai ↗</a><% } %></div>
</form>
<template id="episode-template"><fieldset class="episode"><legend>Tập phim</legend><div class="form-grid"><label>Tên server<input data-key="server" value="Server 1" required maxlength="100"></label><label>Tên tập<input data-key="name" value="Full" required maxlength="100"></label><label>Slug tập<input data-key="slug" value="full" required maxlength="180"></label><label>URL nhúng (iframe)<input data-key="embed" maxlength="2000"></label><label>URL HLS (.m3u8)<input data-key="hls" maxlength="2000"></label><label>Loại nguồn<select data-key="type"><option value="iframe">Iframe</option><option value="m3u8">HLS</option></select></label></div><button type="button" class="button danger-button remove-episode">Bỏ tập này</button></fieldset></template>
