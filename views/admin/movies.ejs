<div class="page-heading"><div><span class="eyebrow">CONTENT LIBRARY</span><h1>Quản lý phim</h1><p>Kho phim MongoDB · thông tin, hình ảnh, tập và nguồn phát.</p></div><a class="button primary" href="/admin/movies/new">＋ Thêm phim</a></div>
<form class="filters" method="get"><label>Tìm phim<input name="q" value="<%= q %>" maxlength="100" placeholder="Tên phim hoặc slug..."></label><label>Loại phim<select name="type"><% [['','Tất cả'],['single','Phim lẻ'],['series','Phim bộ'],['hoathinh','Hoạt hình'],['tvshows','TV Show']].forEach(([value,label]) => { %><option value="<%= value %>" <%= type === value ? 'selected' : '' %>><%= label %></option><% }); %></select></label><label>Hiển thị<select name="state"><% [['','Tất cả'],['published','Đang hiển thị'],['hidden','Đang ẩn'],['vip','VIP']].forEach(([value,label]) => { %><option value="<%= value %>" <%= state === value ? 'selected' : '' %>><%= label %></option><% }); %></select></label><button class="button primary">Lọc</button><a class="button subtle" href="/admin/movies">Đặt lại</a></form>
<section class="panel table-wrap"><table><caption class="sr-only">Danh sách phim</caption><thead><tr><th>Phim</th><th>Năm</th><th>Loại</th><th>Hiển thị</th><th>Thao tác</th></tr></thead><tbody>
<% items.forEach(movie => { %><tr><td><strong><%= movie.title %></strong><small><%= movie.slug %></small></td><td><%= movie.year || '—' %></td><td><%= ({single:'Phim lẻ',series:'Phim bộ',hoathinh:'Hoạt hình',tvshows:'TV Show'})[movie.type] %></td><td><span class="badge <%= movie.isPublished === false ? '' : 'green' %>"><%= movie.isPublished === false ? 'Đang ẩn' : 'Hiển thị' %></span> <% if (movie.isVip) { %><span class="badge gold">VIP</span><% } %></td><td><a class="button subtle" href="/admin/movies/<%= movie._id %>/edit">Chỉnh sửa →</a></td></tr><% }); %>
<% if (!items.length) { %><tr><td colspan="5" class="empty">Chưa có phim phù hợp. <a href="/admin/movies/new">Thêm phim mới</a></td></tr><% } %>
</tbody></table></section><%- include('pagination') %>
