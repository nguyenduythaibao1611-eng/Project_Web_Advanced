<!-- header.ejs -->
<header class="site-header">
    <div class="header-container">
        <a href="/" class="site-logo">
            <h2>🎬 CineVerse</h2>
        </a>
        <nav class="nav-links">
            <a href="/" class="nav-link">Trang chủ</a>
            <a href="/favorites" class="nav-link fav-nav-link">
                <span class="nav-star">★</span> Phim Yêu Thích
                <span class="fav-count-badge" id="favCountBadge" style="display: none;">0</span>
            </a>
            <a href="/search" class="nav-link">Tìm kiếm</a>

            <% if (typeof user !== 'undefined' && user) { %>
                <div class="user-nav-group">
                    <span class="user-greeting" title="<%= user.email %>">
                        <span class="user-icon">👤</span> <%= user.username %>
                    </span>
                    <a href="/logout" class="nav-link nav-btn-logout">Đăng xuất</a>
                </div>
            <% } else { %>
                <div class="auth-nav-group">
                    <a href="/login" class="nav-link nav-btn-login">Đăng nhập</a>
                    <a href="/register" class="nav-link nav-btn-register">Đăng ký</a>
                </div>
            <% } %>
        </nav>
    </div>
</header>