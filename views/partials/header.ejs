<!-- header.ejs - Modern Streaming Navbar -->
<header class="site-header">
    <div class="header-inner">
        <!-- Nhóm bên trái: Hamburger Menu + Điều hướng chính -->
        <div class="header-left">
            <button type="button" class="icon-btn menu-toggle-btn" id="menuToggleBtn" aria-label="Menu" title="Menu danh mục">
                <i class="fa-solid fa-bars"></i>
            </button>

            <a href="/" class="brand-logo" title="CineVerse Home">
                <span class="logo-text">CINEVERSE</span>
            </a>

            <nav class="nav-menu" id="navMenu">
                <!-- 1. HOME - Đã có tính năng, ấn vào chuyển về trang chủ -->
                <a href="/" class="nav-item <%= (typeof title !== 'undefined' && title.includes('Trang chủ')) ? 'active' : '' %>">
                    <span>HOME</span>
                </a>

                <!-- 2. MOVIES - Đã có tính năng (danh sách phim) -->
                <a href="/movies" class="nav-item movies-nav-item <%= (typeof title !== 'undefined' && title.includes('Danh sách Movies')) ? 'active' : '' %>">
                    <span>MOVIES</span>
                </a>

                <!-- 3. LIST (My List) - Đã có tính năng, chuyển đến trang Favorites -->
                <a href="/favorites" class="nav-item fav-nav-item <%= (typeof title !== 'undefined' && title.includes('Yêu Thích')) ? 'active' : '' %>">
                    <span>MY LIST</span>
                    <span class="fav-count-pill" id="favCountBadge" style="display: none;">0</span>
                </a>

                <!-- 4. Nút Tìm kiếm Search -->
                <div class="search-trigger-box">
                    <button type="button" class="icon-btn search-toggle-btn" id="searchToggleBtn" aria-label="Tìm kiếm" title="Tìm kiếm phim" aria-controls="searchExpandBar" aria-expanded="false">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                    <!-- Bảng tìm kiếm nằm dưới header để không che điều hướng -->
                    <form class="search-expand-bar" id="searchExpandBar" action="/search" method="get" role="search" inert>
                        <div class="search-panel-heading">
                            <div>
                                <span class="search-eyebrow">CINEVERSE DISCOVERY</span>
                                <h2>Hôm nay bạn muốn xem gì?</h2>
                            </div>
                            <button type="button" class="search-close" id="quickSearchClose" aria-label="Đóng tìm kiếm" title="Đóng (Esc)"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                        </div>
                        <div class="search-input-row">
                            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                            <input type="search" name="q" id="quickSearchInput" placeholder="Tên phim tiếng Việt hoặc tên gốc..." aria-label="Tên phim" aria-describedby="searchHint" maxlength="200" autocomplete="off" required>
                            <button type="submit" class="search-submit">Tìm kiếm <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                        </div>
                        <div class="search-suggestions" id="searchSuggestions" hidden>
                            <p id="searchStatus" role="status"></p>
                            <ul id="searchSuggestionList" aria-label="Phim gợi ý"></ul>
                        </div>
                        <div class="search-panel-footer" id="searchHint">
                            <span>Nhập từ 2 ký tự để xem gợi ý phim</span>
                            <span><kbd>Esc</kbd> để đóng</span>
                        </div>
                    </form>
                </div>
            </nav>
        </div>

        <!-- Nhóm bên phải: Thông báo + Avatar Profile / Auth -->
        <div class="header-right">
            <!-- Icon Chuông thông báo (Bấm vào hiện dropdown thông báo) -->
            <div class="notification-wrapper">
                <button type="button" class="icon-btn notif-btn" id="notifBtn" aria-label="Thông báo" title="Thông báo mới">
                    <i class="fa-regular fa-bell"></i>
                    <span class="notif-dot"></span>
                </button>
                <div class="notif-dropdown" id="notifDropdown">
                    <div class="notif-header">
                        <h4>Thông Báo</h4>
                        <span class="notif-mark-read">Đã đọc</span>
                    </div>
                    <div class="notif-body">
                        <div class="notif-item">
                            <span class="notif-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
                            <div class="notif-info">
                                <p class="notif-text">Chào mừng bạn đến với giao diện mới của <strong>CineVerse</strong>!</p>
                                <span class="notif-time">Vừa xong</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nút Gói VIP -->
            <a href="/pricing" class="nav-vip-cta" title="Bảng giá gói cước VIP">
                <i class="fa-solid fa-crown"></i> <span>GÓI VIP</span>
            </a>

            <!-- Avatar người dùng hoặc Đăng nhập / Đăng ký -->
            <% if (typeof user !== 'undefined' && user) { %>
                <div class="user-profile-wrapper">
                    <div class="avatar-ring <%= user.isVip ? 'is-vip' : '' %>" id="userAvatarBtn" title="<%= user.username %> (<%= user.email %>)">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80" alt="<%= user.username %>" class="avatar-img">
                    </div>
                    <div class="user-dropdown" id="userDropdown">
                        <div class="user-dropdown-header">
                            <span class="user-name"><%= user.username %> <% if (user.isVip) { %><span class="badge-vip-pill" style="font-size: 0.65rem; padding: 2px 6px;"><i class="fa-solid fa-crown"></i> VIP</span><% } %></span>
                            <span class="user-role"><%= user.email %></span>
                        </div>
                        <hr class="user-dropdown-divider">
                        <% if (user.role === 'admin') { %>
                            <a href="/admin" class="user-dropdown-link" style="color: #60a5fa;"><i class="fa-solid fa-gauge-high"></i> Trang Quản Trị</a>
                        <% } %>
                        <% if (user.isVip) { %>
                        <%
                            let countdownStr = 'VIP Vô thời hạn';
                            let expiresIso = '';
                            if (user.vipExpiresAt) {
                                expiresIso = new Date(user.vipExpiresAt).toISOString();
                                const diffMs = new Date(user.vipExpiresAt).getTime() - Date.now();
                                if (diffMs > 0) {
                                    const d = Math.floor(diffMs / (24 * 3600 * 1000));
                                    const h = Math.floor((diffMs % (24 * 3600 * 1000)) / (3600 * 1000));
                                    const m = Math.floor((diffMs % (3600 * 1000)) / (60 * 1000));
                                    countdownStr = String(d).padStart(2, '0') + ':' + String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
                                } else {
                                    countdownStr = '00:00:00';
                                }
                            }
                        %>
                        <a href="/pricing" class="user-dropdown-link user-dropdown-vip-timer" id="userVipLink" style="color: #fbbf24;" title="Thời hạn VIP còn lại (Bấm để gia hạn)">
                            <i class="fa-solid fa-crown"></i> <span id="userVipCountdown" data-expires="<%= expiresIso %>"><%= countdownStr %></span>
                        </a>
                    <% } else { %>
                        <a href="/pricing" class="user-dropdown-link" style="color: #fbbf24;"><i class="fa-solid fa-crown"></i> Nâng cấp VIP</a>
                    <% } %>
                        <a href="/favorites" class="user-dropdown-link"><i class="fa-solid fa-heart"></i> Phim đã lưu</a>
                        <a href="/onboarding" class="user-dropdown-link"><i class="fa-solid fa-sliders"></i> Sở thích phim</a>
                        <a href="/logout" class="user-dropdown-link" style="color: #ef4444;"><i class="fa-solid fa-right-from-bracket"></i> Đăng xuất</a>
                    </div>
                </div>
            <% } else { %>
                <div class="auth-nav-group">
                    <a href="/login" class="nav-btn-login">Đăng nhập</a>
                    <a href="/register" class="nav-btn-register">Đăng ký</a>
                </div>
            <% } %>
        </div>
    </div>
</header>
