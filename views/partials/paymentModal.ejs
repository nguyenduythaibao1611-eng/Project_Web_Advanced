<!-- Modal Thanh Toán VietQR / SePay Nâng Cấp VIP -->
<div id="paymentModalOverlay" class="payment-modal-overlay" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="payment-modal-card">
        <button type="button" class="payment-modal-close" onclick="closePaymentModal()" aria-label="Đóng">&times;</button>

        <!-- Bước 1: Chọn gói (nếu chưa chọn sẵn) -->
        <div id="paymentStepSelect" class="payment-step" style="display: none;">
            <div class="payment-modal-header">
                <span class="payment-tag"><i class="fa-solid fa-crown"></i> CINEVERSE VIP</span>
                <h2>Chọn gói VIP phù hợp</h2>
                <p>Nâng cấp ngay để xem phim không giới hạn thời gian</p>
            </div>
            <div class="payment-plans-list" id="paymentPlansList">
                <!-- Sẽ được nạp động từ JS -->
            </div>
        </div>

        <!-- Bước 2: Quét mã VietQR -->
        <div id="paymentStepQR" class="payment-step" style="display: none;">
            <div class="payment-modal-header">
                <span class="payment-tag"><i class="fa-solid fa-qrcode"></i> THANH TOÁN VIETQR</span>
                <h2 id="modalPlanName">Nâng cấp VIP CineVerse</h2>
                <div class="payment-countdown">
                    <i class="fa-regular fa-clock"></i> Hạn thanh toán: <strong id="qrTimer">15:00</strong>
                </div>
            </div>

            <div class="payment-qr-layout">
                <div class="qr-image-wrapper">
                    <div id="qrLoadingSpinner" class="qr-spinner">
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span>Đang tạo mã VietQR...</span>
                    </div>
                    <img id="qrCodeImg" src="" alt="Mã thanh toán VietQR" class="qr-code-img" style="display: none;">
                </div>

                <div class="payment-info-box">
                    <div class="info-row highlight-row">
                        <span>Số tiền thanh toán:</span>
                        <strong id="modalAmountDisplay" class="text-gold">0 đ</strong>
                    </div>
                    <div class="info-row">
                        <span>Ngân hàng thụ hưởng:</span>
                        <strong id="modalBankId">MBBank</strong>
                    </div>
                    <div class="info-row">
                        <span>Số tài khoản:</span>
                        <div class="copyable-wrap">
                            <strong id="modalBankAccount">...</strong>
                            <button type="button" class="btn-copy" onclick="copyText('modalBankAccount', this)" title="Sao chép">
                                <i class="fa-regular fa-copy"></i>
                            </button>
                        </div>
                    </div>
                    <div class="info-row">
                        <span>Chủ tài khoản:</span>
                        <strong id="modalAccountName">...</strong>
                    </div>
                    <div class="info-row highlight-code-row">
                        <span>Nội dung chuyển khoản:</span>
                        <div class="copyable-wrap">
                            <strong id="modalTransferContent" class="transfer-code">...</strong>
                            <button type="button" class="btn-copy" onclick="copyText('modalTransferContent', this)" title="Sao chép">
                                <i class="fa-regular fa-copy"></i>
                            </button>
                        </div>
                    </div>
                    <p class="payment-note">
                        <i class="fa-solid fa-circle-info"></i> Hãy giữ <strong>đúng nội dung chuyển khoản</strong> để hệ thống tự động nhận diện và kích hoạt VIP trong 1-3 giây.
                    </p>
                </div>
            </div>

            <!-- Thông báo khi kiểm tra mà chưa thanh toán -->
            <div id="paymentPendingAlert" class="payment-pending-alert" style="display: none;">
                <div class="pending-alert-content">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <div>
                        <strong>Chưa nhận được thanh toán</strong>
                        <p>Hệ thống chưa ghi nhận biến động số dư cho mã đơn này. Bạn hãy kiểm tra đã chuyển đúng số tiền và nội dung chuyển khoản nhé.</p>
                    </div>
                </div>
                <div class="pending-alert-actions">
                    <button type="button" class="btn-back-pay" onclick="dismissPendingAlert()">
                        <i class="fa-solid fa-arrow-left"></i> Trở lại để thanh toán (<span id="pendingTimerText">5s</span>)
                    </button>
                </div>
            </div>

            <div class="payment-modal-footer">
                <button type="button" id="btnCheckPayment" class="btn-check-payment">
                    <i class="fa-solid fa-arrows-rotate"></i> Kiểm tra thanh toán
                </button>
            </div>
        </div>

        <!-- Bước 3: Hoàn tất thành công -->
        <div id="paymentStepSuccess" class="payment-step" style="display: none;">
            <div class="payment-success-box">
                <div class="success-icon-wrap">
                    <i class="fa-solid fa-crown"></i>
                </div>
                <h2>NÂNG CẤP VIP THÀNH CÔNG!</h2>
                <p>Chúc mừng bạn đã trở thành thành viên <strong>CineVerse VIP</strong>. Mọi đặc quyền cao cấp đã được kích hoạt tự động.</p>
                <div class="redirect-countdown">
                    <i class="fa-solid fa-circle-notch fa-spin"></i> Tự động chuyển về trang chính sau <strong id="successRedirectTimer">5</strong> giây...
                </div>
                <div class="success-actions">
                    <a href="/" class="btn-success-continue">
                        <i class="fa-solid fa-house"></i> Về trang chính ngay
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/paymentModal.js" defer></script>
