<section class="page-head"><span class="hero-eyebrow">CINEVERSE LIBRARY</span><h1 class="page-title">Thư viện phim</h1><p class="page-sub">Các bộ phim được CineVerse tuyển chọn và xuất bản.</p><form method="get" class="library-search"><label for="library-query">Tìm phim</label><input id="library-query" name="q" value="<%= q %>" maxlength="100" placeholder="Nhập tên phim..."><button class="btn btn-primary">Tìm kiếm</button></form></section>
<section class="page-body"><p class="page-sub"><%= total %> phim · Trang <%= page %> / <%= Math.max(1,pages) %></p><div class="library-grid"><% movies.forEach(movie => { %><a class="library-card" href="/library/<%= movie.slug %>"><% if (movie.poster_url) { %><img src="<%= movie.poster_url %>" alt="" loading="lazy"><% } else { %><div class="library-placeholder">CINEVERSE</div><% } %><div><h2><%= movie.title %></h2><p><%= movie.year || 'Chưa rõ năm' %> · <%= movie.quality %><%= movie.isVip ? ' · VIP' : '' %></p></div></a><% }); %></div><% if (!movies.length) { %><div class="empty-state"><h2>Chưa có phim phù hợp</h2><p>Hãy đổi từ khóa hoặc quay lại sau.</p></div><% } %><nav class="library-pagination" aria-label="Phân trang"><% if (page > 1) { %><a class="btn btn-glass" href="?q=<%= encodeURIComponent(q) %>&amp;page=<%= page-1 %>">Trang trước</a><% } %><% if (page < pages) { %><a class="btn btn-glass" href="?q=<%= encodeURIComponent(q) %>&amp;page=<%= page+1 %>">Trang sau</a><% } %></nav></section>
