<section class="page-head">
    <span class="hero-eyebrow"><i class="fa-solid fa-bookmark"></i> Thư viện của bạn</span>
    <h1 class="page-title">My List</h1>
    <p class="page-sub">Những bộ phim bạn đã lưu để xem bất cứ lúc nào.</p>
</section>

<div class="page-body">
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <p><%= error %></p>
        </div>
    <% } %>

    <% if (movies && movies.length > 0) { %>
        <div class="card-grid" id="favoritesGrid">
            <% movies.forEach(function(movie) { %>
                <%- include('../partials/movieCard', { movie: movie }) %>
            <% }); %>
        </div>
    <% } else { %>
        <div class="empty-state" id="emptyFavorites">
            <i class="fa-regular fa-bookmark"></i>
            <h2>Danh sách của bạn đang trống</h2>
            <p>Bấm biểu tượng <i class="fa-regular fa-bookmark"></i> trên thẻ phim hoặc nút <strong>+ MY LIST</strong> để lưu phim.</p>
            <a href="/" class="btn btn-primary"><i class="fa-solid fa-compass"></i> Khám phá phim</a>
        </div>
    <% } %>
</div>
