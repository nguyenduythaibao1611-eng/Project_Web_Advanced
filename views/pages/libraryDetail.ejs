<section class="page-head"><a href="/library" class="back-link">← Thư viện phim</a><h1 class="page-title"><%= movie.title %></h1><p class="page-sub"><%= movie.origin_name %> · <%= movie.year || 'Chưa rõ năm' %> · <%= movie.time || '' %><%= movie.isVip ? ' · VIP' : '' %></p><p class="detail-overview"><%= movie.overview %></p><div class="genre-tags"><% (movie.genres || []).forEach(genre => { %><span class="genre-pill"><%= genre.name %></span><% }); %></div></section>
<section class="page-body"><% if (!allowed) { %><div class="empty-state"><h2>Phim dành cho thành viên VIP</h2><p>Bạn cần tài khoản VIP để truy cập nguồn phát phim này.</p><% if (!user) { %><a class="btn btn-primary" href="/login?redirect=<%= encodeURIComponent('/library/' + movie.slug) %>">Đăng nhập</a><% } %></div><% } else if (!selected) { %><div class="empty-state"><h2>Nguồn phát đang được cập nhật</h2></div><% } else { %><div class="server-buttons"><% episodes.forEach((episode,index) => { %><a class="server-btn <%= episode === selected ? 'active' : '' %>" href="?episode=<%= index %>#library-player"><%= episode.name %></a><% }); %></div><div id="library-player" class="player-wrapper" style="margin-top:20px"><% if (selected.type === 'iframe') { %><iframe title="Trình phát phim" src="<%= selected.embed %>" sandbox="allow-scripts allow-same-origin allow-forms allow-presentation" allow="fullscreen; encrypted-media; picture-in-picture" allowfullscreen referrerpolicy="no-referrer"></iframe><% } else { %><video controls playsinline style="width:100%;height:100%" src="<%= selected.hls %>"></video><% } %></div><% if (selected.type === 'm3u8') { %><p class="server-hint">Nếu trình duyệt không hỗ trợ HLS, hãy <a href="<%= selected.hls %>" target="_blank" rel="noopener noreferrer">mở nguồn bằng trình phát hỗ trợ HLS</a> hoặc chọn server iframe.</p><% } %><% } %></section>
